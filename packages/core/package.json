{
	"name": "@claudeskill/core",
	"version": "0.3.2",
	"description": "Core encryption and skill management for Claude Skill Sync",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test src/crypto.test.ts src/skill.test.ts",
		"clean": "rm -rf dist .turbo"
	},
	"dependencies": {
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/a14a-org/claudeskill-manager"
	},
	"license": "MIT"
}
