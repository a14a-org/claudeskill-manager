{
	"name": "@claudeskill/server",
	"version": "0.1.0",
	"description": "API server for Claude Skill Sync",
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch --env-file=../../.env src/index.ts",
		"start": "node --env-file=.env dist/index.js",
		"start:prod": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist .turbo",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.14",
		"@noble/hashes": "^2.2.0",
		"@sentry/node": "^10.58.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.25",
		"postgres": "^3.4.9",
		"resend": "^6.12.4"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=20.20.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/a14a-org/claudeskill-manager"
	},
	"license": "MIT"
}
