{
	"name": "claudeskill-monorepo",
	"private": true,
	"packageManager": "bun@1.3.9",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"dev:server": "bun --filter @claudeskill/server dev",
		"dev:cli": "node packages/cli/dist/index.js",
		"start:server": "bun --filter @claudeskill/server start",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"clean": "turbo clean && rm -rf node_modules"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"lefthook": "^2.1.8",
		"postgres": "^3.4.9",
		"turbo": "^2.9.16",
		"typescript": "^5.9.3"
	}
}
